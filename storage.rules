rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    // Any file under workspace/ is readable by authenticated project users.
    // Writes are limited by size (20 MB) and safe content types.
    match /workspace/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('(image|video|application|text|audio)/.*');
      allow delete: if signedIn();
    }
    match /avatars/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn();
    }
  }
}
